# ==========================================
# PUBLIC FRONTEND VARIABLES
# These variables are exposed to the browser
# ==========================================

# VITE_SUPABASE_URL: URL for Supabase authentication and database.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anonymous key for Supabase.
VITE_SUPABASE_ANON_KEY="your-anon-key"

# VITE_API_BASE_URL: Base URL for the backend API if hosted externally.
# Typically empty in development, or set to the production URL.
VITE_API_BASE_URL=""

# ==========================================
# SERVER-ONLY SECRETS
# Never prefix these with VITE_
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Backend Supabase URL.
SUPABASE_URL=""

# SUPABASE_PUBLISHABLE_KEY: Backend Supabase publishable key.
SUPABASE_PUBLISHABLE_KEY=""

# DATABASE_URL: Server-side connection string. Never expose to frontend.
DATABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase admin key.
SUPABASE_SERVICE_ROLE_KEY=""

# STRIPE_SECRET_KEY: Stripe secret key.
STRIPE_SECRET_KEY=""

# GITHUB_PRIVATE_KEY: GitHub App private key.
GITHUB_PRIVATE_KEY=""

# GITHUB_WEBHOOK_SECRET: GitHub webhook secret.
GITHUB_WEBHOOK_SECRET=""
